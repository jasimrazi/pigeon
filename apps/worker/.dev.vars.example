# ==============================================================================
# Pigeon Worker - Local Development Environment Variables (.dev.vars)
# Copy this file to .dev.vars for local testing.
# In staging and production, secrets are configured via `wrangler secret put`
# and settings are configured via Settings > Integrations in the UI.
# NEVER commit real credentials to source control.
# ==============================================================================

# --- BOOTSTRAP GATE VARIABLES ---
# Execution Environment: 'dev', 'staging', or 'prod'.
ENV="dev"

# Dry run mode: 'true' or 'false'. When true, emails are simulated and not sent live.
DRY_RUN="true"

# Global emergency kill switch: 'true' or 'false'. When true, all sending operations halt immediately.
KILL_SWITCH="false"

# Development auth bypass: 'true' allows unauthenticated access to /api/* locally. Honoured ONLY when ENV=dev.
ALLOW_INSECURE_DEV_AUTH="true"

# Safe recipient allowlist in dev: comma-separated list of allowed emails or @domains.
DEV_RECIPIENT_ALLOWLIST="recruiter@example.test, @example.test"

# Master encryption key (32 bytes base64) for encrypting stored secrets at rest.
SETTINGS_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
GOOGLE_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Job seeker / candidate profile email address
OWNER_GMAIL="user@example.com"

# Cloudflare Access Configuration (required when ENV is staging or prod, or when ALLOW_INSECURE_DEV_AUTH=false)
CF_ACCESS_AUD=""
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_ALLOWED_EMAIL=""

# --- OPTIONAL DEV-CONVENIENCE VALUES ---
# These are local fallbacks for development convenience only.
# In staging and production, these values are ignored and MUST be configured in Settings > Integrations.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8787/auth/google/callback"
GOOGLE_SHEET_ID=""
LLM_PROVIDER="workers-ai"
GEMINI_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
USER_AGENT_CONTACT_EMAIL=""
TIMEZONE="UTC"
ALERT_FORWARDING_ADDRESS=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
