{
  "name": "pigeon",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter @pigeon/worker dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @pigeon/dashboard test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parse-eml": "node scripts/parse-eml.mjs",
    "trigger:ingest": "node scripts/trigger.mjs ingest",
    "trigger:score": "node scripts/trigger.mjs score",
    "trigger:draft": "node scripts/trigger.mjs draft",
    "trigger:send": "node scripts/trigger.mjs send",
    "trigger:followups": "node scripts/trigger.mjs followups",
    "trigger:sheets": "node scripts/trigger.mjs sheets",
    "trigger:all": "node scripts/trigger.mjs all",
    "feed:eml": "node scripts/feed-eml.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "db:reset:local": "node scripts/db-reset-local.mjs",
    "settings:rotate": "node scripts/settings-rotate.mjs",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "check:config": "node scripts/check-config.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "smoke:local": "node scripts/smoke-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "postal-mime": "^4.2.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "auditConfig": {
      "//": "bounded schemas in place; revisit zod 4 migration by 2027-02-07",
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
